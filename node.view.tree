				pageUp? <=> event_inc_boost? null
	sub /
		<= String $mol_string
			- \ we don't want native number controls in mobile devices
			- \ https://stackoverflow.com/questions/3790935/can-i-hide-the-html5-number-input-s-spin-box
			type <= type \text
			keyboard \decimal
			value? <=> value_string? \
			hint <= hint \ 
			enabled <= string_enabled <= enabled
			submit? <=> submit? null
			selection? <=> selection? /number
		<= Dec $mol_button_minor
			event_click? <=> event_dec? null
			enabled <= dec_enabled <= enabled
			sub / <= dec_icon $mol_icon_menu_down_outline
		<= Inc $mol_button_minor
			event_click? <=> event_inc? null
			enabled <= inc_enabled <= enabled
			sub / <= inc_icon $mol_icon_menu_up_outline

$bog_basket_kit $mol_page
	drive $bog_basket_drive
	title \Набор
	tools /
		<= Close $mol_link
			hint \Закрыть
			arg *
				screen null
			sub /
				<= Close_icon $mol_icon_close
	body /
		<= Hint $mol_paragraph
			title \Из чего собирается один набор. План точки считается по нему. Цена нужна для подсказки покупателю, её можно не указывать.
		<= Rows $mol_list
			rows <= rows /
				<= Row* $mol_list
					rows /
						<= Row_head* $mol_view
							sub <= row_head* /
								<= Good_title* $mol_string
									hint \Продукт
									value? <=> good_title*? \
								<= Drop* $mol_button_minor
									hint \Убрать продукт
									click? <=> drop*? null
									sub /
										<= Drop_icon* $mol_icon_close
						<= Numbers* $mol_view
							sub /
								<= Kit* $mol_labeler
									title \В наборе, шт.
									content /
										<= Kit_number* $mol_number
											value_min 0
											value? <=> good_kit*? 0
								<= Weight* $mol_labeler
									title \Вес, кг
									content /
										<= Weight_number* $mol_number
											value_min 0
											precision 0.01
											value? <=> good_weight*? 0
								<= Price* $mol_labeler
									title \Цена, ₽
									content /
										<= Price_number* $mol_number
											value_min 0
											value? <=> good_price*? 0
		<= Add $mol_button_major
			title \Добавить продукт
			click? <=> add? null

$bog_basket_spot $mol_page
	drive $bog_basket_drive
	point $bog_basket_point
	buyer_link \
	drop_done? null
	title <= point_title_text \
	tools /
		<= Close $mol_link
			hint \Закрыть
			arg *
				screen null
				point null
			sub /
				<= Close_icon $mol_icon_close
	body <= blocks /
		<= Form $mol_list
			rows /
				<= Title_field $mol_string
					hint \Название
					value? <=> point_title? \
				<= Address $mol_string
					hint \Адрес
					value? <=> point_address? \
				<= Kits_label $mol_labeler
					title \План, наборов
					content /
						<= Kits $mol_number
							value_min 0
							value? <=> point_kits? 0
		<= Goods $mol_labeler
			title \Принято
			content /
				<= Goods_rows $mol_list
					rows <= good_rows /
						<= Good* $bog_basket_bar
							title <= good_title* \
							got <= good_got* 0
							need <= good_need* 0
		<= Shifts $mol_labeler
			title \Смены
			content /
				<= Shifts_rows $mol_list
					rows <= shift_rows /
						<= Shift* $mol_paragraph
							title <= shift_text* \
		<= Buyer $mol_labeler
			title \Код для покупателей
			content /
				<= Buyer_list $mol_list
					rows /
						<= Buyer_hint $mol_paragraph
							title \Распечатайте и повесьте у входа: покупатель увидит, чего не хватает именно здесь.
						<= Buyer_code $bog_qr
							uri <= buyer_link
							gradient_stops /
								\var(--mol_theme_text)
								\var(--mol_theme_text)
						<= Buyer_open $mol_link
							uri <= buyer_link
							target \_blank
							title \Открыть страницу покупателя
		<= Drop $mol_button_minor
			title \Удалить точку
			click? <=> drop? null

$mol_icon_minus $mol_icon path \M19,13H5V11H19V13Z

$bog_basket_tile $mol_view
	mine? 0
	attr *
		^
		bog_basket_tile_full <= full false
	sub /
		<= Add $mol_button_minor
			hint \Принять одну
			click? <=> add? null
			sub /
				<= Bar $bog_basket_bar
					title <= title \
					got <= got 0
					need <= need 0
		<= Mine $mol_view
			sub /
				<= mine_text \
		<= Drop $mol_button_minor
			hint \Убрать одну
			enabled <= drop_enabled false
			click? <=> drop? null
			sub <= drop_content /
				<= Drop_icon $mol_icon_minus

$bog_basket_counter $mol_page
	drive $bog_basket_drive
	point $bog_basket_point
	shift $bog_basket_shift
	title <= point_title \
	tools /
		<= Status $giper_baza_status
	body /
		<= Ask $mol_paragraph
			title <= ask_text \
		<= Tiles $mol_list
			rows <= tiles /
				<= Tile* $bog_basket_tile
					title <= good_title* \
					got <= good_got* 0
					need <= good_need* 0
					mine? <=> good_mine*? 0
		<= Refuse $mol_paragraph
			title \Не принимаем стекло, скоропортящееся, алкоголь и табак.
		<= Kept $mol_paragraph
			title \Отметки сохраняются на телефоне и уйдут в штаб, когда появится связь.
	foot /
		<= Summary $mol_paragraph
			title <= summary_text \
		<= Finish $mol_button_minor
			title \Закончить смену
			click? <=> finish? null

$bog_basket_buyer $mol_page
	shop $bog_basket_shop
	point_id? \
	title <= shop_title \
	body <= blocks /
		<= Points $mol_list
			rows <= point_rows /
				<= Point* $mol_button_minor
					click? <=> point_open*? null
					sub /
						<= Point_title* $mol_view
							sub /
								<= point_title* \
						<= Point_address* $mol_view
							sub /
								<= point_address* \
		<= Intro $mol_paragraph
			title <= intro_text \
		<= Money $mol_labeler
			title \Сколько готовы потратить, ₽
			content /
				<= Money_number $mol_number
					value_min 0
					precision_change 100
					value? <=> money? 500
		<= Goods $mol_list
			rows <= good_rows /
				<= Good* $mol_view
					sub /
						<= Good_title* $mol_view
							sub /
								<= good_title* \
						<= Good_count* $mol_view
							sub /
								<= good_count* \
		<= Note $mol_paragraph
			title <= note_text \
		<= Refuse $mol_paragraph
			title \Не принимаем стекло, скоропортящееся, алкоголь и табак.

$bog_basket_app $mol_book2
	plugins /
		<= Theme $mol_theme_auto
	Placeholder null
	Welcome $mol_page
		title \Корзина
		body <= welcome_blocks /
			<= About $mol_paragraph
				title \Учёт пунктов сбора продуктов. Волонтёр отмечает принятое кнопками, даже без интернета, а штаб видит, чего не хватает на каждой точке.
			<= Drives $mol_labeler
				title \Ваши сборы
				content /
					<= Drives_rows $mol_list
						rows <= drive_rows /
							<= Drive* $mol_link
								arg <= drive_arg* *
								title <= drive_title* \
			<= Create $mol_labeler
				title \Вы координатор
				content /
					<= Create_row $mol_view
						sub /
							<= Create_title $mol_string
								hint \Название сбора
								value? <=> create_title? \
								submit? <=> create? null
							<= Create_run $mol_button_major
								title \Создать
								enabled <= create_enabled false
								click? <=> create?
			<= Join $mol_labeler
				title \Вы волонтёр
				content /
					<= Join_hint $mol_paragraph
						title \Откройте ссылку, которую прислал координатор.
			<= Try $mol_labeler
				title \Хотите посмотреть
				content /
					<= Example $mol_button_major
						title \Показать на примере
						click? <=> example_open? null
	Admission $bog_basket_admission
		link <= admission_link \
	Office $bog_basket_office
		drive <= drive $bog_basket_drive
	Team $bog_basket_team
		drive <= drive
		admit? <=> admit? \
		invite_link <= invite_link \
	Kit $bog_basket_kit
		drive <= drive
	Spot* $bog_basket_spot
		drive <= drive
		point <= spot_point* $bog_basket_point
		buyer_link <= buyer_link* \
		drop_done? <=> spot_close? null
	Points $bog_basket_points
		drive <= drive
		chief <= chief false
		start*? <=> shift_start*? null
	Counter* $bog_basket_counter
		drive <= drive
		point <= shift_point* $bog_basket_point
		shift <= shift* $bog_basket_shift
		finish? <=> shift_finish*? null
	Buyer $bog_basket_buyer
		shop <= shop $bog_basket_shop
		point_id? <=> spot_id? \
