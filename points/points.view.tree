$bog_basket_points $mol_page
	drive $bog_basket_drive
	start*? null
	chief false
	title <= drive_title \
	tools <= tool_list /
		<= Office_link $mol_link
			title \Штаб
			arg *
				screen null
		<= Status $giper_baza_status
	body /
		<= Hint $mol_paragraph
			title <= hint_text \
		<= Rows $mol_list
			rows <= rows /
				<= Row* $mol_button_minor
					click? <=> start*?
