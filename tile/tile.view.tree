$bog_basket_tile $mol_view
	mine? 0
	attr *
		^
		bog_basket_tile_full <= full false
	sub /
		<= Add $mol_button_minor
			hint \Принять одну
			click? <=> add? null
			sub /
				<= Bar $bog_basket_bar
					title <= title \
					got <= got 0
					need <= need 0
		<= Mine $mol_view
			sub /
				<= mine_text \
		<= Drop $mol_button_minor
			hint \Убрать одну
			enabled <= drop_enabled false
			click? <=> drop? null
			sub <= drop_content /
				<= Drop_icon $mol_icon_minus
